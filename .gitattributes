# Use Linux (LF) line endings everywhere, in the repo and in working copies,
# regardless of the platform or the user's core.autocrlf setting.
* text=auto eol=lf

# Binary files: never convert or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.wasm binary
*.bcmap binary
*.pfb  binary
*.icc  binary
*.zip  binary
*.exe  binary
*.dll  binary
